# Copy to .env and fill in. Never commit .env.

# Financial Modeling Prep API key
FMP_API_KEY=

# Anthropic API key (agents)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Any Postgres. Default below is the local Supabase stack (`supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Protects /api/cron/* when deployed (send as `Authorization: Bearer <value>`). Optional locally.
CRON_SECRET=
