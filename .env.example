# Copy to .env and fill in. Never commit .env.

# Market data: yahoo (default, no key) or fmp
DATA_PROVIDER=yahoo
# Only needed when DATA_PROVIDER=fmp
FMP_API_KEY=

# Agents use your Claude login via the `claude` command by default (run `claude` once to log in).
# To use a pay-per-use API key instead, set it here (or force with LLM_BACKEND=api / cli).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Any Postgres. Default below is the local Supabase stack (`supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Protects /api/cron/* when deployed (send as `Authorization: Bearer <value>`). Optional locally.
CRON_SECRET=
